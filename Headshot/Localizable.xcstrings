    "studio.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una foto o elige una"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire uma foto ou escolha uma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo ou choisissez-en une"
          }
        }
      }
    },
    "studio.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For job applications, visas, and professional profiles. The studio keeps you looking like you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para postulaciones de trabajo, visas y perfiles profesionales. El estudio te deja viéndote como tú."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para candidaturas, vistos e perfis profissionais. O estúdio mantém a sua cara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les candidatures, visas et profils professionnels. Le studio vous laisse ressembler à vous-même."
          }
        }
      }
    },
    "studio.caption.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighting, background, and clothes only. Your face stays yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo luz, fondo y ropa. Tu cara no cambia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só luz, fundo e roupa. O seu rosto continua o mesmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumière, fond et vêtements seulement. Votre visage reste le vôtre."
          }
        }
      }
    },
    "studio.caption.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face the camera in good light. A simple snapshot is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira a la cámara con buena luz. Una foto simple alcanza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhe para a câmera com boa luz. Uma foto simples basta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez l’appareil en bonne lumière. Une photo simple suffit."
          }
        }
      }
    },
    "studio.caption.generating.cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending a small photo. Slow internet is OK — you can retry if it fails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando una foto pequeña. Si la red es lenta, espera o reintenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando uma foto pequena. Internet lenta serve — dá para tentar de novo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi d’une petite photo. Un réseau lent convient — vous pourrez réessayer."
          }
        }
      }
    },
    "studio.caption.generating.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working on this iPhone: crop, background, and light. No photo is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja en este iPhone: recorte, fondo y luz. No se sube la foto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste iPhone: recorte, fundo e luz. Nenhuma foto é enviada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitement sur cet iPhone : cadrage, fond et lumière. Aucun envoi."
          }
        }
      }
    },
    "studio.caption.result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide to compare. Save or share when it looks right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para comparar. Guarda o comparte cuando te convenza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para comparar. Salve ou compartilhe quando gostar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez pour comparer. Enregistrez ou partagez si c’est bon."
          }
        }
      }
    },
    "studio.caption.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original photo is unchanged. Try again, or pick another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto original no se modificó. Reintenta o elige otra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua foto original não mudou. Tente de novo ou escolha outra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photo d’origine n’a pas changé. Réessayez ou choisissez-en une autre."
          }
        }
      }
    },
