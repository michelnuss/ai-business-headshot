{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot uses the camera to take a portrait for job, visa, and professional photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot usa la cámara para tomar un retrato para trabajo, visa o perfil profesional."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Headshot usa a câmera para um retrato de trabalho, visto ou perfil profissional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot utilise l’appareil photo pour un portrait professionnel, visa ou candidature."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot saves the finished studio photo to your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot guarda la foto de estudio terminada en tu galería."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Headshot salva a foto de estúdio pronta na sua galeria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot enregistre la photo studio dans votre bibliothèque."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot uses your photo library so you can choose a portrait to turn into a studio photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot usa tu galería para que elijas un retrato y lo convierta en foto de estudio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Headshot usa sua galeria para você escolher um retrato e transformá-lo em foto de estúdio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Headshot utilise votre photothèque pour choisir un portrait à transformer."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
