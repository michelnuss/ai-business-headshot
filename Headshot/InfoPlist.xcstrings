  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI uses the camera to take a portrait for job, visa, and LinkedIn photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI usa la cámara para un retrato de trabajo, visa o LinkedIn."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProHeadshot AI usa a câmera para um retrato de trabalho, visto ou LinkedIn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI utilise l’appareil photo pour un portrait professionnel, visa ou LinkedIn."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI saves the finished studio photo to your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI guarda la foto de estudio terminada en tu galería."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProHeadshot AI salva a foto de estúdio pronta na sua galeria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI enregistre la photo studio dans votre bibliothèque."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI uses your photo library so you can choose a portrait to turn into a studio photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI usa tu galería para que elijas un retrato y lo convierta en foto de estudio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ProHeadshot AI usa sua galeria para você escolher um retrato e transformá-lo em foto de estúdio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProHeadshot AI utilise votre photothèque pour choisir un portrait à transformer."
          }
        }
      }
    },
